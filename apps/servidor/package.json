{
  "name": "@factpos/servidor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "migrar": "tsx src/migrar.ts",
    "semilla": "tsx src/semilla.ts",
    "vercel-build": "cd ../.. && npm run build -w @factpos/compartido && npm run build -w @factpos/servidor && node scripts/vercel-compartido.mjs",
    "padron": "tsx src/padron-cli.ts"
  },
  "dependencies": {
    "@factpos/compartido": "0.1.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/static": "^8.3.0",
    "@xmldom/xmldom": "^0.9.12",
    "decimal.js": "^10.4.3",
    "fastify": "^5.0.0",
    "fflate": "^0.8.3",
    "multicast-dns": "^7.2.5",
    "node-forge": "^1.4.2",
    "pg": "^8.13.0",
    "xml-crypto": "^6.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/multicast-dns": "^7.2.4",
    "@types/node": "^22.0.0",
    "@types/node-forge": "^1.3.14",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
