{
  "name": "@factpos/escritorio",
  "version": "0.1.0",
  "private": true,
  "description": "Ventana de escritorio para FactPOS Caja y Administración",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.factpos.escritorio",
    "productName": "FactPOS Escritorio",
    "asar": true,
    "files": ["main.cjs", "package.json"],
    "directories": { "output": "out" },
    "win": { "target": ["portable"], "artifactName": "FactPOS-Escritorio-${version}.exe" }
  }
}
